{
  "name": "notefall88-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "audit:musicxml": "vite-node scripts/audit-musicxml-corpus.ts",
    "dev": "vite --host 0.0.0.0",
    "predev:studio": "node scripts/sync-studio-vendor.mjs",
    "dev:studio": "vite --config vite.studio.config.ts --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "prebuild:studio": "node scripts/sync-studio-vendor.mjs",
    "build:studio": "tsc -b && vite build --config vite.studio.config.ts",
    "verify:studio": "node scripts/verify-studio-dist.mjs",
    "smoke:pwa-offline": "node scripts/pwa-offline-smoke.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tonejs/midi": "2.0.28",
    "@xmldom/xmldom": "0.9.11",
    "fflate": "0.8.2",
    "opensheetmusicdisplay": "1.9.9",
    "webmscore-webpack5": "0.21.0-a"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.17",
    "@types/node": "24.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "fake-indexeddb": "6.2.2",
    "typescript": "5.9.2",
    "vite": "8.2.0",
    "vite-node": "6.0.0",
    "vitest": "4.1.10"
  }
}
